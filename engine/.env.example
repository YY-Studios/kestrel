# Supabase (서버 전용)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 한국투자증권(KIS) Open API — 해외주식. broker-client가 사용한다.
KIS_APP_KEY=            # KIS에서 발급받은 App Key
KIS_APP_SECRET=         # KIS에서 발급받은 App Secret
KIS_ACCOUNT_NO=         # 계좌번호 (해외주식 모의/실전)
KIS_IS_PAPER=true       # true=모의투자(기본), false=실전. 실전은 명시적으로만 켠다(ADR-005)

# 조건 감시 주기(초)
POLL_INTERVAL_SECONDS=5

# --- 주문 실행 (기본 드라이런) ---
# LIVE_ORDERS=true 이고 KIS_IS_PAPER=true 일 때만 실주문(모의계좌). real은 항상 차단.
# LIVE_ORDERS=true
# TOTAL_CAPITAL=1600       # 1차 수량 = floor((TOTAL_CAPITAL/3 × 0.40) / 현재가). 1주면 ≈ 현재가×7.5.
                           # 예: 현재가 $210 → TOTAL_CAPITAL≈1600에서 1주. 소액으로 1~2주만.
# WATCHLIST_OVERRIDE=NAS:NVDA  # (검증 통제) 있으면 DB 워치리스트 무시하고 이 종목만. 1종목 강제.
# WATCHLIST=NAS:AAPL       # DB가 비었을 때만 쓰는 폴백(통제용 아님 — 통제는 WATCHLIST_OVERRIDE).

# --- 검증용 진입 완화 프로필 (평상시 미설정 = 영향 0, docs/LIVE_VERIFICATION.md) ---
# ENTRY_PROFILE=verify     # 진입까지 도달하는 완화 프리셋 묶음(추세우회+눌림0~99%+반등1+RSI100)
# 또는 개별 완화만:
# ENTRY_TREND_BYPASS=true      # 추세 필터 우회
# ENTRY_REBOUND_REQUIRED=1     # 반등 신호 필요 개수(기본 2)
# ENTRY_PULLBACK_MIN_DROP=0.0  # 눌림목 최소 하락률(기본 0.05)
# ENTRY_PULLBACK_MAX_DROP=0.99 # 눌림목 최대 하락률(기본 0.10)
# ENTRY_RSI_THRESHOLD=100      # RSI 과매도 임계(기본 35)
